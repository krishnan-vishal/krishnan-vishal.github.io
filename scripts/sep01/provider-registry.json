      "adapter": null,
      "status": "registered_only",
      "health": "no authenticated headless worker"
    },
    {
      "id": "copilot",
      "kind": "cli",
      "adapter": null,
      "status": "registered_only",
      "health": "no authenticated worker"
    },
    {
      "id": "aider",
      "kind": "cli",
      "adapter": null,
      "status": "registered_only",
      "health": "no authenticated worker"
    }
  ],
  "integration_contract": {
    "required": [
      "id",
      "kind",
      "adapter",
      "health",
      "approval_scope",
      "checkpoint_protocol",
      "idempotency",
      "sensitivity_policy"
    ],
    "policy": "New providers remain ineligible until server-side auth, capability, quota handling, checkpoint recovery and isolated acceptance pass. Never send API keys or arbitrary code to public dashboard."
  }
}
