{
  "name": "gpir-acquisition-preview",
  "main": "cloudflare-acquisition-preview.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../.cloudflare-preview-dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/__gpir_acquisition_probe"
    ]
  }
}
