# Payload runtime. Use a dedicated login that inherits only gpir_payload_runtime.
PAYLOAD_DATABASE_URI=postgresql://payload_runtime:replace-me@db.example.invalid:5432/postgres?sslmode=require
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Supabase remains the authority for GPIR identity, access and release decisions.
SUPABASE_URL=https://project-ref.supabase.co
GPIR_SUPABASE_SECRET_KEY=server-only-secret-key

# The release service signs every immutable release artifact.
GPIR_RELEASE_SIGNING_SECRET=replace-with-a-separate-32-byte-secret
PAYLOAD_RELEASE_API_KEY=replace-with-a-payload-release-service-api-key

# Supabase Storage S3 protocol. These server-only keys bypass Storage RLS.
S3_BUCKET=gpir-payload-media
S3_ENDPOINT=https://project-ref.storage.supabase.co/storage/v1/s3
S3_REGION=project-region
S3_ACCESS_KEY_ID=server-only-access-key
S3_SECRET_ACCESS_KEY=server-only-secret-key

# Contentful export only. Never expose these through NEXT_PUBLIC_* variables.
CONTENTFUL_SPACE_ID=replace-me
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_MANAGEMENT_TOKEN=replace-me

# Import/export paths are ignored by Git.
CONTENTFUL_BACKUP_DIR=../../.migration-data/contentful
