{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpir-payload-cms",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4398c601c5dc4e39bb2b35f76ff72845",
      "remote": true
    }
  ]
}
