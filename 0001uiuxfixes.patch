diff --git a/assets/css/site-polish.css b/assets/css/site-polish.css
new file mode 100644
index 0000000..3915322
--- /dev/null
+++ b/assets/css/site-polish.css
@@ -0,0 +1,167 @@
+/* ==========================================================
+   FINTECH OASIS | GPIR
+   Site Polish — final pass
+   Accessibility, motion, micro-interactions
+========================================================== */
+
+/* ----------------------------------------------------------
+   SKIP TO CONTENT (keyboard / screen-reader users)
+---------------------------------------------------------- */
+
+.skip-link{
+
+    position:absolute;
+
+    top:-60px;
+
+    left:16px;
+
+    z-index:3000;
+
+    background:#12325B;
+
+    color:#ffffff;
+
+    padding:12px 22px;
+
+    border-radius:8px;
+
+    font-weight:700;
+
+    text-decoration:none;
+
+    transition:top .25s ease;
+}
+
+.skip-link:focus{
+
+    top:16px;
+}
+
+
+/* ----------------------------------------------------------
+   FOCUS STATES
+---------------------------------------------------------- */
+
+a:focus-visible,
+button:focus-visible{
+
+    outline:3px solid var(--color-primary);
+
+    outline-offset:3px;
+
+    border-radius:4px;
+}
+
+
+/* ----------------------------------------------------------
+   SELECTION COLOUR
+---------------------------------------------------------- */
+
+::selection{
+
+    background:rgba(184,134,59,.32);
+
+    color:inherit;
+}
+
+
+/* ----------------------------------------------------------
+   SCROLLBAR
+---------------------------------------------------------- */
+
+html{
+
+    scrollbar-color:var(--color-primary) transparent;
+
+    scrollbar-width:thin;
+}
+
+::-webkit-scrollbar{
+
+    width:10px;
+}
+
+::-webkit-scrollbar-track{
+
+    background:transparent;
+}
+
+::-webkit-scrollbar-thumb{
+
+    background:var(--color-primary);
+
+    border-radius:10px;
+}
+
+
+/* ----------------------------------------------------------
+   SCROLL-REVEAL ANIMATION
+   (elements start hidden only once JS confirms it can
+   animate them back in — see assets/js/script.js)
+---------------------------------------------------------- */
+
+.reveal-on-scroll{
+
+    opacity:0;
+
+    transform:translateY(28px);
+
+    transition:
+        opacity .7s ease,
+        transform .7s ease;
+}
+
+.reveal-on-scroll.is-visible{
+
+    opacity:1;
+
+    transform:translateY(0);
+}
+
+@media (prefers-reduced-motion:reduce){
+
+    .reveal-on-scroll{
+
+        opacity:1;
+
+        transform:none;
+
+        transition:none;
+    }
+
+}
+
+
+/* ----------------------------------------------------------
+   HEADER — SCROLLED STATE POLISH
+---------------------------------------------------------- */
+
+.header.scrolled .header-container{
+
+    min-height:72px;
+}
+
+.header.scrolled .brand-logo{
+
+    width:135px;
+}
+
+
+/* ----------------------------------------------------------
+   IMAGE LOADING POLISH
+---------------------------------------------------------- */
+
+img[loading="lazy"]{
+
+    opacity:0;
+
+    animation:imgFadeIn .5s ease forwards;
+}
+
+@keyframes imgFadeIn{
+
+    from{ opacity:0; }
+    to{ opacity:1; }
+
+}
